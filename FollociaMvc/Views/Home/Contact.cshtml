@model FollociaMvc.Models.ContactFormModel
@{
    ViewData["Title"] = "Contact Us | Follicia Footwear";
}

<div class="page-banner">
    <div class="section-container">
        <span class="eyebrow-tag">CONTACT US</span>
        <h1>Get in Touch with Follicia</h1>
        <p>We are here to help you with your orders, size guidance, shipping questions, or any feedback.</p>
    </div>
</div>

<section class="contact-section">
    <div class="section-container">
        <div class="contact-grid">
            <div class="contact-info-col">
                <div class="info-card-gold">
                    <h3>Follicia Studio</h3>
                    <p>513/8, Chunnipura, Rohtak-124001,<br />Haryana, India</p>
                    <p><strong>Phone Support:</strong> +91 7082216801</p>
                    <p><strong>Email Support:</strong> support@follicia.com</p>
                    <p><strong>Working Hours:</strong> Monday – Saturday (10:00 AM – 7:00 PM IST)</p>
                </div>

                <div class="info-card">
                    <h4>Customer Support &amp; Order Help</h4>
                    <p>Our support team is happy to assist you with order status, easy returns, exchanges, and doorstep delivery updates.</p>
                </div>
            </div>

            <div class="contact-form-col">
                @if (Model.SuccessMessage)
                {
                    <div class="alert-success-gold">
                        <h3>Thank You for Contacting Us</h3>
                        <p>We have received your message. Our team will review your request and get back to you within 24 hours.</p>
                    </div>
                }

                <form asp-controller="Home" asp-action="SubmitContact" method="post" class="luxury-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name">Full Name</label>
                            <input asp-for="Name" required placeholder="e.g. Priya Sharma" class="input-gold" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" type="email" required placeholder="name@example.com" class="input-gold" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Phone">Phone / WhatsApp</label>
                            <input asp-for="Phone" placeholder="+91 7082216801" class="input-gold" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Subject">Topic / Subject</label>
                            <select asp-for="Subject" class="input-gold">
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Order &amp; Delivery Query">Order &amp; Delivery Query</option>
                                <option value="Size &amp; Fit Assistance">Size &amp; Fit Assistance</option>
                                <option value="Returns &amp; Exchange">Returns &amp; Exchange</option>
                                <option value="Customization &amp; Bulk Request">Customization &amp; Bulk Request</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message">Your Message</label>
                        <textarea asp-for="Message" rows="5" placeholder="Write your message or question here..." class="input-gold"></textarea>
                    </div>

                    <button type="submit" class="btn-gold-solid btn-full">SEND MESSAGE</button>
                </form>
            </div>
        </div>
    </div>
</section>

