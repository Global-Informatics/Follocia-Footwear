@{
    ViewData["Title"] = "Privacy & Confidentiality | Maison Follocia";
}

<div class="page-banner">
    <div class="section-container">
        <span class="eyebrow-tag">CONFIDENTIALITY & LEGAL</span>
        <h1>Privacy & Client Vows</h1>
        <p>Maison Follocia adheres to strict private client confidentiality for all reservations, bespoke fittings, and white-glove deliveries.</p>
    </div>
</div>

<section class="section-container" style="max-width: 900px; padding: 4rem 2rem;">
    <div style="background: var(--ink-card); border: 1px solid rgba(212, 175, 55, 0.2); padding: 3rem; color: rgba(250, 248, 245, 0.85); line-height: 1.8;">
        <h2 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--gold-light); margin-bottom: 1.5rem;">1. Private Atelier Confidentiality</h2>
        <p style="margin-bottom: 2rem;">All client information, size profiles, reservation records, and delivery locations are treated with absolute discretion. We do not sell, exchange, or share private patron data with third-party tracking networks.</p>

        <h2 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--gold-light); margin-bottom: 1.5rem;">2. Certificate & Authenticity Tracking</h2>
        <p style="margin-bottom: 2rem;">Each edition is bound to a physical numbered parchment certificate. Ownership transfers are securely cataloged upon private concierge verification to protect limited-edition provenance.</p>

        <h2 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--gold-light); margin-bottom: 1.5rem;">3. White-Glove Courier Data</h2>
        <p style="margin-bottom: 2rem;">Delivery parameters are transmitted exclusively to our insured private courier partners for the sole purpose of hand-executing your reservation shipment.</p>

        <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; margin-top: 3rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--gold);">
            <span>Maison Follocia · Florence, Italy</span>
            <a asp-controller="Home" asp-action="Contact" class="btn-gold-outline-sm">CONTACT CONCIERGE</a>
        </div>
    </div>
</section>
