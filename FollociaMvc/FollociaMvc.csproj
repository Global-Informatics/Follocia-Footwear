<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <Target Name="StopLockedDebugHost" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <Exec IgnoreExitCode="true" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$projectBin = '$(TargetDir)'; Get-CimInstance Win32_Process | Where-Object { $_.Name -in @('dotnet.exe','FollociaMvc.exe') -and ($_.CommandLine -like '*FollociaMvc.dll*' -or ($_.ExecutablePath -and $_.ExecutablePath -like ($projectBin + '*'))) } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\src\**\*" Link="React_Source\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\package.json" Link="package.json" />
    <Content Include="..\tsconfig.json" Link="tsconfig.json" />
    <Content Include="..\vite.config.ts" Link="vite.config.ts" />
  </ItemGroup>

</Project>
